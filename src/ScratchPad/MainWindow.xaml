<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ScratchPad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScratchPad">

    <!-- D01 T02 §15: stock Notepad is Mica Alt, not base Mica. Same-machine
         probes put stock's tab strip at (10,10,7) dark / (205,223,224) light,
         the Alt tint; base Mica rendered our strip flat at 32 / 243. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <!-- Shell regions in Notepad layout. Owners fill them: MenuBar items are D01 T02 §1,
         the TabView is D01 T01 §3, the editor is D02 T01, the status segments are D01 T02 §4. -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 43/32: measured stock geometry (D01 T01 §27). Canonical
                 captures put stock's tab strip at 0-42 (tab bottom edge 41,
                 earliest menu content 48) and its menu row at 42-75 (File
                 text 53-63 centered, editor step at 75). The old 48/48 put
                 our editor at 96 DIP, 21 below stock's 75; 43/32 lands it within a pixel (captured 76 DIP,
                 stock 75). T02 §1's MenuBar must fit the 32-DIP menu row. -->
            <RowDefinition Height="43" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusRow" Height="32" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="TabRegion" Grid.Row="0" AutomationProperties.AutomationId="TabRegion" AutomationProperties.Name="Tab region" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <!-- D01 T02 §15: the menu and status bands are the layer fill stock
             lays on Mica Alt (LayerOnMicaBaseAltFillColorDefault), and the
             editor sits on the tertiary solid fill. Theme resources, so the
             Light/Dark/HighContrast dictionaries and D01 T02 §10's accent
             pipeline keep owning the values. -->
        <Grid Grid.Row="1" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:AppMenuBar x:Name="MenuRegion" Grid.Column="0" AutomationProperties.AutomationId="MenuRegion" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="WhatsNewButton" AutomationProperties.AutomationId="WhatsNewButton" AutomationProperties.Name="What's new" Click="WhatsNewButton_Click" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE789;" FontSize="16" />
                </Button>
                <Button x:Name="SettingsButton" AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="Settings" Click="SettingsButton_Click" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <ContentControl x:Name="EditorRegion" Grid.Row="2" AutomationProperties.AutomationId="EditorRegion" AutomationProperties.Name="Editor region" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ContentControl.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="TextControlBackground" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="TextControlBackground" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ContentControl.Resources>
        </ContentControl>

        <!-- ContentControl's template draws no Background, so the status band's
             layer fill is its own element; StatusRow collapsing to 0 hides it. -->
        <Border Grid.Row="3" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" />

        <ContentControl x:Name="StatusRegion" Grid.Row="3" AutomationProperties.AutomationId="StatusRegion" AutomationProperties.Name="Status region" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <!-- Settings overlay, owned by D01 T02 §3: covers all rows like
             stock (tabs, menus, editor, status all hide behind it). -->
        <Grid x:Name="SettingsRegion" Grid.RowSpan="4" Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              AutomationProperties.AutomationId="SettingsRegion">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button x:Name="SettingsBackButton" Grid.Row="0" HorizontalAlignment="Left" Margin="24,12,0,0"
                    AutomationProperties.AutomationId="SettingsBackButton" AutomationProperties.Name="Back"
                    Click="SettingsBackButton_Click" Background="Transparent" BorderThickness="0">
                <SymbolIcon Symbol="Back" />
            </Button>
            <local:SettingsPage x:Name="SettingsView" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
