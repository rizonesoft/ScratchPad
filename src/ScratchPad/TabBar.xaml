<UserControl
    x:Class="ScratchPad.TabBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- D01 T02 §15: stock's selected tab is the menu band's layer fill, so
         tab and menu read as one surface; probes sample stock's tab at
         (32,31,30) dark / (241,245,245) light against the menu's
         (31,32,30) / (240,245,245). WinUI's default (the tertiary solid)
         sampled 40 / 249 here. HighContrast keeps the system brush. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerOnMicaBaseAltFillColorDefaultBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerOnMicaBaseAltFillColorDefaultBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- D01 T01 §3: the tab strip. The TabView is deliberately unbound: the
         code-behind builds one TabViewItem per Tab so the container-to-model
         mapping (Tag) is exact with no ItemsSource magic.
         CanReorderTabs is off as parity: three live probes dragged stock
         tabs (named tabs, on-screen foreground window) and the order never
         moved. CanDragTabs is off with it; stock has no tear-off. -->
    <TabView
        x:Name="Tabs"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        AutomationProperties.AutomationId="Tabs"
        CanDragTabs="False"
        CanReorderTabs="False"
        TabWidthMode="SizeToContent"
        SelectionChanged="Tabs_SelectionChanged"
        TabCloseRequested="Tabs_TabCloseRequested" />
</UserControl>
