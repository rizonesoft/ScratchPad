<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Makes the SDK record the assembly's timestamps around compile
         (_AssemblyTimestampBeforeCompile/After), which the build-inputs
         digest target reads (D00 T02 §44 R1-F3); no post-build event is
         defined, so nothing else changes. -->
    <RunPostBuildEvent>OnOutputUpdated</RunPostBuildEvent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScratchPad\ScratchPad.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\resources\baseline\app\main-window.png" Link="goldens\main-window.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\resources\baseline\app\settings-page.png" Link="goldens\settings-page.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\resources\baseline\stock\notepad-main-n11.2607.14.0-win25h2.png" Link="goldens\stock-main.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\resources\baseline\tolerance.json" Link="tolerance.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ResolveAppPath" BeforeTargets="Build" DependsOnTargets="PrepareForBuild">
    <MSBuild Projects="..\..\src\ScratchPad\ScratchPad.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="AppTargetPath" />
    </MSBuild>
    <WriteLinesToFile File="$(OutputPath)apppath.txt" Lines="@(AppTargetPath)" Overwrite="true" />
  </Target>

  <Target Name="ResolveForegroundLogPath" BeforeTargets="Build" DependsOnTargets="PrepareForBuild">
    <MSBuild Projects="..\..\tools\ForegroundLog\ForegroundLog.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="ForegroundLogTargetPath" />
    </MSBuild>
    <WriteLinesToFile File="$(OutputPath)fglogpath.txt" Lines="@(ForegroundLogTargetPath)" Overwrite="true" />
  </Target>

  <!-- Content provenance (D00 T02 §44 item 1): after every build, the
       digest of the build inputs' content plus the SDK version lands
       beside the binary, and the population gate's freshness check
       compares it, so timestamps never decide freshness alone. It is
       rewritten only when this build compiled the UI assembly (R1-F3,
       R2-F3): an incremental build that compiled nothing, even one that
       copied a changed reference or found no digest, keeps the digest of
       what it last compiled (or none), so an edit whose timestamp was
       restored still reads stale and the refusal names a rebuild with
       no incremental skips. -->
  <Target Name="WriteBuildInputsDigest" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and '$(_AssemblyTimestampBeforeCompile)' != '$(_AssemblyTimestampAfterCompile)'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Write-BuildInputsDigest.ps1&quot; -Root &quot;$(MSBuildThisFileDirectory)..\..&quot; -Out &quot;$(OutputPath)build-inputs.digest&quot; -Sdk &quot;$(NETCoreSdkVersion)&quot;" StandardOutputImportance="low" />
  </Target>

</Project>
