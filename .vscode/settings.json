{
  // Pre-commit checkouts land in .git/hookgate.* (D00 T01 §12). Without this
  // exclude the file watcher adds those projects to the C# Dev Kit solution,
  // and NuGet restore fails after the checkout is removed.
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.hg/store/**": true,
    "**/node_modules/*/**": true,
    "**/.git/hookgate.*/**": true,
    "**/.git/worktrees/**/hookgate.*/**": true
  }
}
