{
  "permissions": {
    "allow": [
      "command(regex:^git status --short$)",
      "command(regex:^git rev-parse HEAD$)",
      "command(regex:^git --no-pager show --no-ext-diff --no-textconv (HEAD|[0-9a-f]{40})$)",
      "command(regex:^git --no-pager diff --no-ext-diff --no-textconv (HEAD|[0-9a-f]{40})(\\.\\.(HEAD|[0-9a-f]{40}))?$)"
    ],
    "deny": [
      "write_file(*)",
      "edit_file(*)"
    ]
  }
}
